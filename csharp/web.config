<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" 
                  arguments=".\AdQueryOrchestrator.dll" 
                  stdoutLogEnabled="true" 
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- P05 Slice 2: outer IIS ceiling sits 1 MiB above the 96 MiB
               application body cap (CsvEnrichment:Limits:MaxRequestBodyBytes) so
               the overflow band reaches the application-owned 413 with its
               problem-details body. Change both ceilings together; never restore
               the stale 10 MiB value. -->
          <requestLimits maxAllowedContentLength="101711872" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="X-XSS-Protection" value="1; mode=block" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
